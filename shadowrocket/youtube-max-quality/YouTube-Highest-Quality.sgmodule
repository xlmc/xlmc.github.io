#!name=YouTube去广告+最高画质 v19.1
#!desc=Shadowrocket 合并热修版 v19.1。保持 v19 的启动与最高画质逻辑不变，只修复去广告脚本因持久化缓存 JSON 损坏而在每次响应上抛出 Unexpected EOF、导致广告处理提前退出的问题。检测到损坏的 YouTubeAdvertiseInfo / YouTubeConfig 时会本地重置默认值后继续去广告。
#!author=xlmc / Maasea / nrhb11
#!homepage=https://github.com/xlmc/xlmc.github.io/tree/main/shadowrocket/youtube-max-quality
#!icon=https://www.youtube.com/s/desktop/d4c4d43f/img/favicon_144x144.png
#!category=YouTube

[Rule]
# YouTube 广告域名本地拒绝。
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,2mdn.net,REJECT
DOMAIN-SUFFIX,googletagservices.com,REJECT
DOMAIN,youtube-ads.l.google.com,REJECT

# 让 player/SABR 可被 HTTPS MITM 脚本处理；不经过远程 Worker。
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# 本地去除低层播放广告标记；普通 videoplayback 正片不做 reject。
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback(?:\?|\/))).+&oad data-type=text data=" " status-code=200

[Script]
# 单一移动端响应链：
# 1) 只读解析真实 /player 响应并缓存当前视频最高规格；
# 2) 同一脚本继续执行 Maasea-derived Protobuf 去广告；
# 3) 只有这一条脚本负责 /player 的 $done()，避免处理器冲突。
youtube.mobile.noads.max = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(\?.*)?$, script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/shadowrocket/youtube-max-quality/yt-mobile-noads-max-shadowrocket.js?v=19.1, requires-body=true, binary-body-mode=true, max-size=0, engine=auto

# 只修改 SABR 选流请求。无额外 /player 网络请求，无 initplayback Worker。
youtube.max.sabr = type=http-request, pattern=^https:\/\/[^/]+\.googlevideo\.com\/videoplayback(?:\?|\/|$), script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/shadowrocket/youtube-max-quality/yt-sabr-shadowrocket.js?v=19, requires-body=true, binary-body-mode=true, max-size=-1, engine=auto

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
