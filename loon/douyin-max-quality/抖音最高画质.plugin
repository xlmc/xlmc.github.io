#!name = 抖音最高画质
#!desc = 抖音移动端视频优先尝试原画/超高清播放源：使用抖音 play 接口的 ratio=default + improve_bitrate=1；获取不到时自动回退到接口实际下发的最高 bit_rate 档。用户主页作品列表 aweme/post、评论及其他非播放数据接口不处理，避免影响页面加载。
#!author = xlmc
#!homepage = https://github.com/xlmc/xlmc.github.io/tree/main/loon/douyin-max-quality
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 抖音,最高画质,原画,4K,最高码率
#!type = normal

[Argument]
enabled = switch,true,tag=抖音视频最高画质,desc=播放视频时优先原画/超高清源，失败时回退到抖音实际下发的最高码率档；主页作品列表和评论等非播放接口不处理

[Script]
response if ${url} ~= /^https:\/\/(?:[^\/]+\.)?(?:amemv\.com|snssdk\.com|douyin\.com|iesdouyin\.com)\/aweme\/v\d+\/(?:feed|aweme\/detail|multi\/aweme\/detail|follow\/feed|nearby\/feed|search\/item|general\/search\/single|hot\/search\/video\/list|aweme\/favorite|mix\/aweme)(?:\/|\?|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/douyin-max-quality/douyin-max-quality.js?v=6") with enable=${enabled}, tag="抖音最高画质 v6", timeout=20, requires_body=true

[Mitm]
hostname = *.amemv.com, *.snssdk.com, *.douyin.com, *.iesdouyin.com
