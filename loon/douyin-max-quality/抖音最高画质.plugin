#!name = 抖音最高画质
#!desc = 抖音移动端视频优先尝试原画/超高清播放源：使用抖音 play 接口的 ratio=default + improve_bitrate=1；获取不到时自动回退到接口实际下发的最高 bit_rate 档。仅拦截明确返回视频资源的接口，评论、主页框架及其他非视频接口不处理。
#!author = xlmc
#!homepage = https://github.com/xlmc/xlmc.github.io/tree/main/loon/douyin-max-quality
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 抖音,最高画质,原画,4K,最高码率
#!type = normal

[Argument]
enabled = switch,true,tag=抖音视频最高画质,desc=优先原画/超高清源，失败时回退到抖音实际下发的最高码率档；评论等非视频接口不处理

[Script]
response if ${url} ~= /^https:\/\/(?:[^\/]+\.)?(?:amemv\.com|snssdk\.com|douyin\.com|iesdouyin\.com)\/aweme\/v\d+\/(?:feed|aweme\/detail|multi\/aweme\/detail|aweme\/post|follow\/feed|nearby\/feed|search\/item|general\/search\/single|hot\/search\/video\/list|aweme\/favorite|mix\/aweme)(?:\/|\?|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/douyin-max-quality/douyin-max-quality.js?v=5") with enable=${enabled}, tag="抖音最高画质 v5", timeout=20, requires_body=true

[Mitm]
hostname = *.amemv.com, *.snssdk.com, *.douyin.com, *.iesdouyin.com
