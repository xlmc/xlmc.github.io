#!name = 抖音最高画质
#!desc = 抖音移动端所有普通视频都优先使用接口实际下发的最高视频规格。排序：分辨率 > HDR > 高帧率 > 码率；脚本仅改写响应中的视频对象，非视频数据保持不变。
#!author = xlmc
#!homepage = https://github.com/xlmc/xlmc.github.io/tree/main/loon/douyin-max-quality
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 抖音,最高画质,HDR,高帧率
#!type = normal

[Argument]
enabled = switch,true,tag=抖音视频最高画质,desc=推荐、详情、搜索、作品、关注、收藏、合集等普通视频均优先使用接口实际下发的最高规格

[Script]
response if ${url} ~= /^https:\/\/(?:[^\/]+\.)?(?:amemv\.com|snssdk\.com|douyin\.com|iesdouyin\.com)\/aweme\/v\d+\/(?:[^?#]*)?(?:\?|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/douyin-max-quality/douyin-max-quality.js?v=2") with enable=${enabled}, tag="抖音最高画质", timeout=20, requires_body=true

[Mitm]
hostname = *.amemv.com, *.snssdk.com, *.douyin.com, *.iesdouyin.com
