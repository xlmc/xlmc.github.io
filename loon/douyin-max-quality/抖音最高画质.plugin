#!name = 抖音最高画质
#!desc = v8 改为只重写真正的视频播放请求，不再修改 feed/detail 等业务响应。播放 /aweme/v*/play/ 时把 ratio 强制为 default、improve_bitrate=1，并移除固定转码档参数；推荐、分页、评论、主页作品等数据完全不碰。
#!author = xlmc
#!homepage = https://github.com/xlmc/xlmc.github.io/tree/main/loon/douyin-max-quality
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 抖音,最高画质,原画,4K,最高码率
#!type = normal

[Argument]
enabled = switch,true,tag=抖音视频最高画质,desc=仅改实际播放请求为原画/超高清参数，不修改推荐算法、分页、评论或主页数据

[Script]
request if ${url} ~= /^https:\/\/(?:aweme\.snssdk\.com|api\.amemv\.com)\/aweme\/v\d+\/play\/?(?:\?|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/douyin-max-quality/douyin-max-quality.js?v=8") with enable=${enabled}, tag="抖音最高画质 v8", timeout=15

[Mitm]
hostname = aweme.snssdk.com, api.amemv.com
