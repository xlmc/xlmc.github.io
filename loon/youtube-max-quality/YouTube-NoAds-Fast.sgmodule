#!name=YouTube去广告-快速本地版
#!desc=Shadowrocket 独立去广告 Fast v1。与最高画质模块完全分离；移除 Maasea initplayback Worker 链路，避免 init-stream.maasea.workers.dev 的长延迟与 BAD_DECRYPT。保留移动端 Protobuf 响应去广告，并增加本地 ctier/oad 广告兜底。不会修改普通 videoplayback 正片。
#!author=xlmc / Maasea / nrhb11
#!category=YouTube

[Rule]
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,2mdn.net,REJECT
DOMAIN-SUFFIX,googletagservices.com,REJECT
DOMAIN,youtube-ads.l.google.com,REJECT

[URL Rewrite]
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback(?:\?|\/))).+&oad data-type=text data=" " status-code=200

[Script]
# 固定版本的移动端 Protobuf 响应处理器；只处理 youtubei 响应，不使用远程 initplayback Worker。
youtube.noads.mobile = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|config|log_event)(\?.*)?$, script-path=https://raw.githubusercontent.com/nrhb11/surge-modules/3e3ad363e5c045d4a5f2db06ea50186ce8b0f581/modules/streaming/youtube/vendor/youtube-mobile-response.js, requires-body=true, binary-body-mode=true, max-size=0, engine=auto

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
