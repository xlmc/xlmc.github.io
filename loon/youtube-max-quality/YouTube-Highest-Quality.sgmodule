#!name=YouTube最高画质
#!desc=Shadowrocket 模块：YouTube 官方客户端自动选择当前视频实际可用的最高画质。排序：分辨率 > HDR > 高帧率 > 码率；Premium 账号如实际下发 Enhanced Bitrate，则同一规格优先高码率格式。
#!author=xlmc
#!homepage=https://github.com/xlmc/xlmc.github.io/tree/main/loon/youtube-max-quality
#!icon=https://www.youtube.com/s/desktop/d4c4d43f/img/favicon_144x144.png
#!category=YouTube

[Script]
YouTube最高画质·Player = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=auto,script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-quality-probe.js?v=8
YouTube最高画质·SABR = type=http-request,pattern=^https:\/\/[^/]+\.googlevideo\.com\/videoplayback(?:\?|\/|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=auto,script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-sabr-probe.js?v=8

[MITM]
hostname = %APPEND% youtubei.googleapis.com, *.googlevideo.com
