[Script]
YouTube最高画质·Player = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=auto,script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-quality-probe.js?v=10
YouTube最高画质·SABR = type=http-request,pattern=^https:\/\/[^/]+\.googlevideo\.com\/videoplayback(?:\?|\/|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=auto,script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-sabr-probe.js?v=10

[MITM]
hostname = %APPEND% youtubei.googleapis.com, *.googlevideo.com
