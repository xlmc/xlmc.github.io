#!name=YouTube去广告+最高画质
#!desc=Shadowrocket 合并稳定版 v21。单一 /player 响应脚本同时完成本地去广告与最高规格缓存，不复制 /player、不调用远程 Worker。v21 撤回对 initplayback 的激进本地短路：播放握手保持原生；首个 SABR 只做安全的 Higher Quality/Unmetered 提示，不强塞具体 FormatId，待客户端暴露实际可用视频格式后再锁定同分辨率/编码/HDR档，避免 8K/AV1 等“服务端有、设备不能播”的格式导致报错和重试。
#!author=xlmc / Maasea / nrhb11
#!homepage=https://github.com/xlmc/xlmc.github.io/tree/main/loon/youtube-max-quality
#!icon=https://www.youtube.com/s/desktop/d4c4d43f/img/favicon_144x144.png
#!category=YouTube

[Rule]
# YouTube 广告域名本地拒绝。
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,2mdn.net,REJECT
DOMAIN-SUFFIX,googletagservices.com,REJECT
DOMAIN,youtube-ads.l.google.com,REJECT

# 让 player/SABR 可被 HTTPS MITM 脚本处理；不经过远程 Worker。
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# 本地去除低层播放广告标记；普通 videoplayback 正片不做 reject。
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Map Local]
# 只拦截明确的 oad 广告资源；排除 videoplayback 与 initplayback，避免破坏播放握手。
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback(?:\?|\/)|initplayback(?:\?|\/))).+&oad data-type=text data=" " status-code=200

[Script]
# 单一移动端响应链：
# 1) 只读解析真实 /player 响应并缓存当前视频最高规格；
# 2) 同一脚本继续执行 Maasea-derived Protobuf 去广告；
# 3) 只有这一条脚本负责 /player 的 $done()，避免处理器冲突。
youtube.mobile.noads.max = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(\?.*)?$, script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-mobile-noads-max-shadowrocket.js?v=21, requires-body=true, binary-body-mode=true, max-size=0, engine=auto

# 只修改 SABR 选流请求。首包安全 prime，随后按客户端实际可用编码/分辨率锁定，优先稳定播放。
youtube.max.sabr = type=http-request, pattern=^https:\/\/[^/]+\.googlevideo\.com\/videoplayback(?:\?|\/|$), script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-sabr-shadowrocket.js?v=21, requires-body=true, binary-body-mode=true, max-size=-1, engine=auto

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
