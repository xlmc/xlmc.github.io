#!name=YouTube去广告+最高画质
#!desc=Shadowrocket 合并稳定版 v22。恢复 v19 已验证较好的启动与强制画质路径：单一 /player 响应脚本、本地去广告、无重复 /player、无远程 Worker；只增加一个窄修复——当视频声明 8K 等超高规格时，iOS 最高锁到 2160p 档，避免 itag 702 反复触发回退/报错。其余 SABR 行为保持 v19。
#!author=xlmc / Maasea / nrhb11
#!homepage=https://github.com/xlmc/xlmc.github.io/tree/main/loon/youtube-max-quality
#!icon=https://www.youtube.com/s/desktop/d4c4d43f/img/favicon_144x144.png
#!category=YouTube

[Rule]
# YouTube 广告域名本地拒绝。
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,2mdn.net,REJECT
DOMAIN-SUFFIX,googletagservices.com,REJECT
DOMAIN,youtube-ads.l.google.com,REJECT

# 让 player/SABR 可被 HTTPS MITM 脚本处理；不经过远程 Worker。
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# 本地去除低层播放广告标记；普通 videoplayback 正片不做 reject。
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback(?:\?|\/))).+&oad data-type=text data=" " status-code=200

[Script]
# 单一移动端响应链：
# 1) 只读解析真实 /player 响应并缓存当前视频最高规格；
# 2) 同一脚本继续执行 Maasea-derived Protobuf 去广告；
# 3) 只有这一条脚本负责 /player 的 $done()，避免处理器冲突。
youtube.mobile.noads.max = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(\?.*)?$, script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-mobile-noads-max-shadowrocket.js?v=22, requires-body=true, binary-body-mode=true, max-size=0, engine=auto

# 只修改 SABR 选流请求。无额外 /player 网络请求，无 initplayback Worker。
youtube.max.sabr = type=http-request, pattern=^https:\/\/[^/]+\.googlevideo\.com\/videoplayback(?:\?|\/|$), script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-sabr-shadowrocket.js?v=22, requires-body=true, binary-body-mode=true, max-size=-1, engine=auto

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
