#!name=YouTube最高画质
#!desc=Shadowrocket 独立最高画质模块 v15。与任何 YouTube 去广告模块分离：本模块不删除广告、不修改 /player 响应，只在 /player 请求阶段旁路获取当前视频真实可用规格并缓存多个视频目标，再在 SABR 请求中按 分辨率 > HDR > 高帧率 > 码率 强制当前视频最高档。内置诊断日志用于一次性定位未命中原因。
#!author=xlmc
#!homepage=https://github.com/xlmc/xlmc.github.io/tree/main/loon/youtube-max-quality
#!icon=https://www.youtube.com/s/desktop/d4c4d43f/img/favicon_144x144.png
#!category=YouTube

[Rule]
# 强制 YouTube 的 player/SABR 回落到可被 HTTPS MITM 脚本处理的 TCP；不包含任何广告规则。
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Script]
# 只观察原始 /player 请求，并向同一个 YouTube /player 端点发起一次旁路副本以读取规格；不修改原请求/响应。
youtube.max.player.probe = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$, script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-player-target-shadowrocket.js?v=15, requires-body=true, binary-body-mode=true, max-size=0, engine=auto

# 只修改 googlevideo SABR 选流请求；不接触 browse/next/player 响应，不与去广告 response 脚本争用。
youtube.max.sabr = type=http-request, pattern=^https:\/\/[^/]+\.googlevideo\.com\/videoplayback(?:\?|\/|$), script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-sabr-shadowrocket.js?v=15, requires-body=true, binary-body-mode=true, max-size=-1, engine=auto

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
