#!name=YouTube最高画质
#!desc=Shadowrocket 独立最高画质模块 v18。与去广告完全分离：不删除广告。v18 不再复制 /player 网络请求，而是在真实 /player 响应到达时只读解析 streamingData，本地缓存最高档，再由 SABR 锁定手动画质状态、selected/preferred FormatId 与 PlaybackCookie；保留 v17 的同档编码稳定与 buffered_ranges 实际缓冲验证。
#!author=xlmc
#!homepage=https://github.com/xlmc/xlmc.github.io/tree/main/loon/youtube-max-quality
#!icon=https://www.youtube.com/s/desktop/d4c4d43f/img/favicon_144x144.png
#!category=YouTube

[Rule]
# 强制 YouTube 的 player/SABR 回落到可被 HTTPS MITM 脚本处理的 TCP；不包含任何广告规则。
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Script]
# 只读观察真实 /player 响应并本地解析规格；不修改响应，也不额外发起任何网络请求。
youtube.max.player.observe = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$, script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-player-target-shadowrocket.js?v=18, requires-body=true, binary-body-mode=true, max-size=0, engine=auto

# 只修改 googlevideo SABR 选流请求；不接触 browse/next/player 响应，不与去广告 response 脚本争用。
youtube.max.sabr = type=http-request, pattern=^https:\/\/[^/]+\.googlevideo\.com\/videoplayback(?:\?|\/|$), script-path=https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-sabr-shadowrocket.js?v=18, requires-body=true, binary-body-mode=true, max-size=-1, engine=auto

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
