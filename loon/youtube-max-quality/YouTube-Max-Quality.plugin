#!name = YouTube Max Quality Probe
#!desc = 一次播放完整抓取 YouTube 画质选择链路：Player 原始响应、SABR selected/preferred itag 与 ABR 状态、HLS 备用清单。原始 protobuf 仅缓存在 Loon 本地，当前版本只读，不修改播放数据。
#!author = xlmc
#!homepage = https://github.com/xlmc/xlmc.github.io/tree/main/loon/youtube-max-quality
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = YouTube,画质,SABR,调试
#!type = normal

[Argument]
enabled = switch,true,tag=启用全量抓取,desc=一次播放抓取 Player/SABR/HLS 所需数据并缓存在 Loon 本地
debug = switch,true,tag=调试日志,desc=在 Loon 中保留详细脚本执行日志

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|get_watch)(?:\?|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-quality-probe.js?v=4") with enable=${enabled}, tag="YouTube 全量抓取 · Player", timeout=20, debug=${debug}, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/manifest\.googlevideo\.com\/api\/manifest\/hls_variant\//i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-hls-probe.js?v=4") with enable=${enabled}, tag="YouTube 全量抓取 · HLS", timeout=20, debug=${debug}, requires_body=true
request if ${url} ~= /^https:\/\/(?:redirector\.)?googlevideo\.com\/initplayback(?:\?|$)|^https:\/\/[^/]+\.googlevideo\.com\/(?:initplayback|videoplayback)(?:\?|\/|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-sabr-probe.js?v=4") with enable=${enabled}, tag="YouTube 全量抓取 · SABR", timeout=15, debug=${debug}, requires_body=true, binary_body_mode=true
network-changed then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-capture-report.js?v=5") with enable=${enabled}, tag="YouTube 全量抓取报告", timeout=20, debug=${debug}

[Mitm]
hostname = youtubei.googleapis.com, manifest.googlevideo.com, redirector.googlevideo.com, *.googlevideo.com
