#!name = YouTube最高画质
#!desc = YouTube 官方客户端自动选择当前视频实际可用的最高画质。排序按官方画质菜单语义：分辨率 > HDR > 高帧率 > 码率；例如 2160p60 HDR > 2160p HDR > 2160p60 > 2160p。Premium 账号如实际下发 Enhanced Bitrate，则同一规格优先高码率格式。
#!author = xlmc
#!homepage = https://github.com/xlmc/xlmc.github.io/tree/main/loon/youtube-max-quality
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = YouTube,最高画质,HDR,高帧率,SABR
#!type = normal

[Argument]
enabled = switch,true,tag=自动最高画质,desc=按 YouTube 官方画质菜单规格自动选择：分辨率 > HDR > 高帧率 > 码率
debug = switch,false,tag=调试日志,desc=需要排查时开启，正常使用建议关闭

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-quality-probe.js?v=8") with enable=${enabled}, tag="YouTube最高画质 · Player", timeout=20, debug=${debug}, requires_body=true, binary_body_mode=true
request if ${url} ~= /^https:\/\/[^/]+\.googlevideo\.com\/videoplayback(?:\?|\/|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-sabr-probe.js?v=8") with enable=${enabled}, tag="YouTube最高画质 · SABR", timeout=15, debug=${debug}, requires_body=true, binary_body_mode=true

[Mitm]
hostname = youtubei.googleapis.com, *.googlevideo.com
