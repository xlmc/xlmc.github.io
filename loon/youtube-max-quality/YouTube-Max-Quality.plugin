#!name = YouTube Max Quality Probe
#!desc = 探测 YouTube 官方客户端实际播放画质、1080p Premium / Enhanced Bitrate 提示与 SABR/HLS 播放链路。当前版本只读响应/请求，不修改播放数据。
#!author = xlmc
#!homepage = https://github.com/xlmc/xlmc.github.io/tree/main/loon/youtube-max-quality
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = YouTube,画质,调试
#!type = normal

[Argument]
enabled = switch,true,tag=启用探测,desc=只读取 YouTube 播放链路并输出结果，不修改视频数据
debug = switch,true,tag=调试日志,desc=在 Loon 中输出脚本调试日志
notify = switch,true,tag=结果通知,desc=检测到 Premium 或常见高清画质标记时发送系统通知

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|get_watch)(?:\?|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-quality-probe.js?v=2", {${notify}}) with enable=${enabled}, tag="YouTube 画质探测", timeout=20, debug=${debug}, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/manifest\.googlevideo\.com\/api\/manifest\/hls_variant\//i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-hls-probe.js?v=1") with enable=${enabled}, tag="YouTube HLS 实际流探测", timeout=20, debug=${debug}, requires_body=true
request if ${url} ~= /^https:\/\/(?:redirector\.)?googlevideo\.com\/initplayback(?:\?|$)|^https:\/\/[^/]+\.googlevideo\.com\/(?:initplayback|videoplayback)(?:\?|\/|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-sabr-probe.js?v=1") with enable=${enabled}, tag="YouTube SABR 实际流探测", timeout=10, debug=${debug}, requires_body=true, binary_body_mode=true

[Mitm]
hostname = youtubei.googleapis.com, manifest.googlevideo.com, redirector.googlevideo.com, *.googlevideo.com
