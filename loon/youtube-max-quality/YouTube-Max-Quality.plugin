#!name = YouTube Max Quality
#!desc = YouTube 官方客户端自动选择当前视频实际可用的最高画质。普通点播/SABR：自动锁定最高分辨率，并优先最高分辨率对应的视频格式；Premium 账号如实际下发 Enhanced Bitrate，则同分辨率优先高码率格式。
#!author = xlmc
#!homepage = https://github.com/xlmc/xlmc.github.io/tree/main/loon/youtube-max-quality
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = YouTube,最高画质,SABR
#!type = normal

[Argument]
enabled = switch,true,tag=自动最高画质,desc=播放时自动选择当前视频实际可用的最高分辨率
debug = switch,false,tag=调试日志,desc=需要排查时开启，正常使用建议关闭

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-quality-probe.js?v=6") with enable=${enabled}, tag="YouTube Max Quality · Player", timeout=20, debug=${debug}, requires_body=true, binary_body_mode=true
request if ${url} ~= /^https:\/\/[^/]+\.googlevideo\.com\/videoplayback(?:\?|\/|$)/i then script("https://raw.githubusercontent.com/xlmc/xlmc.github.io/main/loon/youtube-max-quality/yt-sabr-probe.js?v=6") with enable=${enabled}, tag="YouTube Max Quality · SABR", timeout=15, debug=${debug}, requires_body=true, binary_body_mode=true

[Mitm]
hostname = youtubei.googleapis.com, *.googlevideo.com
